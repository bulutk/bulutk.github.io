// --- Act IV: Utopia Creation Logic ---

function accrueEnlightenmentEnergy(tickSeconds) {
    if (gameState.currentAct !== 4) return;

    let eePerSecond = 0;

    // Iterate through purchased Act IV upgrades for their effects
    gameState.act4.purchasedUtopiaUpgrades.forEach(purchasedId => {
        const upgrade = upgrades[purchasedId];
        if (upgrade && upgrade.effects) {
            if (upgrade.effects.enlightenmentEnergyPerSecond) {
                eePerSecond += upgrade.effects.enlightenmentEnergyPerSecond;
            }
            // Specific check for UPG_SCIENTIFIC_RESEARCH
            if (purchasedId === "UPG_SCIENTIFIC_RESEARCH" && upgrade.effects.enlightenmentEnergyPerFollowerPerMinute) {
                const eeFromFollowersPerMinute = gameState.resources.followers * upgrade.effects.enlightenmentEnergyPerFollowerPerMinute;
                eePerSecond += eeFromFollowersPerMinute / 60; // Convert per minute to per second
            }
        }
    });
    
    eePerSecond *= gameState.globalProductionMultiplier;
    gainResource('enlightenmentEnergy', eePerSecond * tickSeconds);
}

function handleEEMilestones() {
    for (const milestone of eeMilestoneEpilogues) {
        if (gameState.resources.enlightenmentEnergy >= milestone.threshold && lastEEMilestone < milestone.threshold) {
            addNarrativeLog(milestone.line, 'epilogue');
            lastEEMilestone = milestone.threshold;
        }
    }
}

function updateUtopiaPanel() {
    // Update progress bar
    let ee = gameState.resources.enlightenmentEnergy;
    let progress = Math.min(99, Math.floor((ee / 150) * 100));
    gameState.act4.globalEnlightenmentProgress = progress;
    globalEnlightenmentProgressBar.style.width = progress + '%';
    globalEnlightenmentProgressValue.textContent = progress + '%';
    // Show Initiate Final Alignment button if conditions met
    if (ee >= 150 && progress >= 99) {
        initiateFinalAlignmentButton.style.display = 'inline-block';
        gameState.act4.initiateFinalAlignmentAvailable = true;
    } else {
        initiateFinalAlignmentButton.style.display = 'none';
        gameState.act4.initiateFinalAlignmentAvailable = false;
    }
}

function handleUniversalFestivalMusic() {
    if (gameState.purchasedUpgrades.has('UPG_UNIVERSAL_FESTIVAL') && !universalFestivalMusicPlayed) {
        // Play choral music (placeholder)
        addNarrativeLog("A lush choral swell fills the world! (music would play)", 'event-positive');
        universalFestivalMusicPlayed = true;
        // TODO: Play actual music if available
    }
}

function handleActIVClick() {
    // This function is intended to be called IF there's a generic click action in Act IV
    // The GDD mentions "Click SFX: calm ethereal choir note" but not a specific button.
    // Utopia upgrades themselves grant EE/click, which should apply to *their own purchase click* or a general game interaction.
    // For now, this function can be a central point if a "Focus Energy" button is added.
    // It's NOT directly tied to buying upgrades.
    // The EE/click from upgrades is currently not applied to any general click.
    // Let's assume there isn't a general click-for-EE button. The SFX might be for upgrade clicks or milestone popups.
    // The EE/click from specific Act IV upgrades should ideally modify a base EE/click value if one existed.
    // Since it doesn't, we'll assume for now the "EE/click" in upgrades.js for Act IV is a one-time bonus on purchase,
    // or passive generation if "click" was misinterpreted for "tick" or an active ability.
    // GDD: "Cultural Fusion: +1 EE/click", "Ascension Gate: +2 EE/click"
    // This needs clarification. If it means "per any click in the game", then:
    
    if (gameState.currentAct !== 4) return;

    let eeFromClick = 0;
     gameState.act4.purchasedUtopiaUpgrades.forEach(purchasedId => {
        const upgrade = upgrades[purchasedId];
        if (upgrade && upgrade.effects && upgrade.effects.enlightenmentEnergyPerClick) {
            eeFromClick += upgrade.effects.enlightenmentEnergyPerClick;
        }
    });

    if (eeFromClick > 0) {
        const finalEEClick = eeFromClick * gameState.globalProductionMultiplier;
        gainResource('enlightenmentEnergy', finalEEClick);
        createFloatingText(`+${formatNumber(finalEEClick)} EE`, eeValueEl);
        playSound('calm_ethereal_choir_note');
    }
    // This function should be hooked to a relevant click event in Act IV, if one exists.
    // e.g. document.getElementById('some_act4_interactive_element').onclick = handleActIVClick;
}

