// Basic deep merge utility (can be replaced with a library like lodash.merge for robustness)
function deepMerge(target, source) {
    const output = Object.assign({}, target);
    if (isObject(target) && isObject(source)) {
        Object.keys(source).forEach(key => {
            if (isObject(source[key])) {
                if (!(key in target)) {
                    Object.assign(output, { [key]: source[key] });
                } else {
                    output[key] = deepMerge(target[key], source[key]);
                }
            } else {
                Object.assign(output, { [key]: source[key] });
            }
        });
    }
    return output;
}

function isObject(item) {
    return (item && typeof item === 'object' && !Array.isArray(item));
}

function renderActIVUpgrades() {
    if (!act4UpgradesContainer) return;
    act4UpgradesContainer.innerHTML = ''; 
    
    // This const *MUST* be defined globally or passed in. Assuming it is global for now.
    // const act4UpgradeRevealOrder = ["UPG_MEDITATION_RETREATS", ..., "UPG_UNIVERSAL_FESTIVAL"];
    if (typeof act4UpgradeRevealOrder === 'undefined') {
        console.error("act4UpgradeRevealOrder is not defined. Cannot render Act IV upgrades.");
        act4UpgradesContainer.textContent = "Error: Act IV upgrade sequence not defined.";
        return;
    }

    let nextUnpurchasedFound = false;
    for (const upgradeId of act4UpgradeRevealOrder) {
        const upgrade = upgrades[upgradeId];
        if (!upgrade || upgrade.act !== 4) continue;

        const isPurchased = gameState.act4.purchasedUtopiaUpgrades.includes(upgradeId);

        if (isPurchased) { 
            const el = createUpgradeButtonElement(upgrade, true);
            act4UpgradesContainer.appendChild(el);
        } else if (!nextUnpurchasedFound) { 
            const el = createUpgradeButtonElement(upgrade, false);
            act4UpgradesContainer.appendChild(el);
            nextUnpurchasedFound = true;
        }
    }
}

function createUpgradeButtonElement(upgrade, isPurchased) {
    const el = document.createElement('button');
    el.id = upgrade.id;
    el.classList.add('upgrade-button');
    const cost = getUpgradeCost(upgrade); 
    const resourceName = upgrade.resource === "enlightenmentEnergy" ? "EE" : (upgrade.resource || 'Clarity');

    el.innerHTML = `
        <strong>${upgrade.name}</strong><br>
        <small>${upgrade.description}</small><br>
        Cost: ${formatNumber(cost)} ${resourceName}
    `;

    if (isPurchased) {
        el.disabled = true;
        el.classList.add('purchased');
        el.innerHTML += "<br><small>(Purchased)</small>";
    } else {
        if (!canAfford(upgrade.resource, cost)) {
            el.disabled = true;
        }
        el.onclick = () => buyUpgrade(upgrade.id);
    }
    return el;
}

function updateGlobalEnlightenmentProgress() {
    // This const *MUST* be defined globally or passed in. Assuming it is global for now.
    // const act4UpgradeRevealOrder = ["UPG_MEDITATION_RETREATS", ..., "UPG_UNIVERSAL_FESTIVAL"];
    if (typeof act4UpgradeRevealOrder === 'undefined') {
        console.error("act4UpgradeRevealOrder is not defined. Cannot update progress.");
        return;
    }
    const totalUtopiaUpgradesInOrder = act4UpgradeRevealOrder.length;
    
    if (totalUtopiaUpgradesInOrder === 0) {
        gameState.act4.globalEnlightenmentProgress = 0;
    } else {
        const purchasedUtopiaCount = gameState.act4.purchasedUtopiaUpgrades.length;
        gameState.act4.globalEnlightenmentProgress = Math.min(99, (purchasedUtopiaCount / totalUtopiaUpgradesInOrder) * 99);
    }

    if (globalEnlightenmentProgressBar && globalEnlightenmentProgressValue) {
        globalEnlightenmentProgressBar.style.width = gameState.act4.globalEnlightenmentProgress + '%';
        globalEnlightenmentProgressValue.textContent = Math.floor(gameState.act4.globalEnlightenmentProgress) + '%';
        const utopiaPanelVisible = gameState.visiblePanels.has('PANEL_UTOPIA');
        // Assuming progress bar is inside a container that should be visible with the panel
        if (globalEnlightenmentProgressBar.parentElement) { 
            globalEnlightenmentProgressBar.parentElement.style.display = utopiaPanelVisible ? 'block' : 'none';
        }
    }
}

